{
  "name": "qixin-eyewear-lead-engine-lab",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/discovery.test.mjs tests/lead-engine.test.mjs tests/pilot-pack.test.mjs && npm run test:unit",
    "test:unit": "node --import tsx --test tests/automatic-engine-behavior.test.mjs tests/migration-forward-only.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "bench:campaign-save": "node --import tsx scripts/benchmark-campaign-save.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@tabler/icons-react": "3.46.0",
    "drizzle-orm": "0.45.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/workers-types": "^5.20260814.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "^8.2.1",
    "wrangler": "^4.123.0"
  },
  "type": "module"
}

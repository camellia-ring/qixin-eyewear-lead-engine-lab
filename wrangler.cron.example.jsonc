{
  // Deploy this Worker separately only after replacing the database_id with the private Lead Engine D1 ID.
  "name": "qixin-lead-engine-cron",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qixin-lead-engine-private",
      "database_id": "REPLACE_WITH_PRIVATE_LEAD_ENGINE_D1_ID"
    }
  ],
  "vars": {
    "ENABLE_PAID_PROVIDERS": "false"
  }
}
